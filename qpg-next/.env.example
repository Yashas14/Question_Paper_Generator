# ============================================
# Question Paper Generator — Environment Config
# ============================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/qpg_db?schema=public"

# --- NextAuth.js ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- AWS S3 / Cloudflare R2 ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="qpg-uploads"
AWS_S3_ENDPOINT="" # Leave empty for AWS S3, set for R2/MinIO

# --- OpenAI ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# --- Redis (Upstash or local) ---
REDIS_URL="redis://localhost:6379"

# --- Resend (Email) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourapp.com"

# --- Meilisearch ---
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# --- Sentry (Error Tracking) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- App Config ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="QPG — Question Paper Generator"
